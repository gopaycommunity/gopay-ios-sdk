# Gateway settings for the example app, read by `scripts/run-demo.sh`.
#
# Copy this file to `.env` and fill in your GoPay credentials. `.env` is gitignored; this file is
# committed and must stay empty of real values. The five keys are the ones `DemoOverrides` reads,
# and the same five the Android demo takes, so one `.env` serves both platforms. Each is optional:
# whatever you leave out keeps its compiled-in value.
#
# A `#` starts a comment only at the start of a line. Everything after `=` is the value, so an
# inline comment would become part of the credential.

# The gateway to talk to.
#   sandbox:    https://gw.sandbox.gopay.com/gp-gw/api/4.0/
#   production: https://gate.gopay.com/gp-gw/api/4.0/
GOPAY_DEMO_BASE_URL=
GOPAY_DEMO_CLIENT_ID=
GOPAY_DEMO_SHAREABLE_KEY=
# A merchant secret. It is here only because the demo fakes the merchant backend in-app; a real app
# never carries one.
GOPAY_DEMO_CLIENT_SECRET=
GOPAY_DEMO_GOID=
